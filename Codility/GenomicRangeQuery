// More efficient solution: 
func Solution(S string, P []int, Q []int) []int {
    N := len(S)
    M := len(P)

    // Prefix sums for A, C, G
    A := make([]int, N+1)
    C := make([]int, N+1)
    G := make([]int, N+1)

    for i := 0; i < N; i++ {
        A[i+1] = A[i]
        C[i+1] = C[i]
        G[i+1] = G[i]

        switch S[i] {
        case 'A':
            A[i+1]++
        case 'C':
            C[i+1]++
        case 'G':
            G[i+1]++
        }
        // We ignore 'T' because it's implied if none of the others increased
    }

    result := make([]int, M)

    for i := 0; i < M; i++ {
        from := P[i]
        to := Q[i] + 1 // inclusive range

        if A[to]-A[from] > 0 {
            result[i] = 1
        } else if C[to]-C[from] > 0 {
            result[i] = 2
        } else if G[to]-G[from] > 0 {
            result[i] = 3
        } else {
            result[i] = 4
        }
    }

    return result
}
