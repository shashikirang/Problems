Given a stream of integers and a window size k, implement a class that efficiently computes the moving average of the last k integers.


#include <queue>

class MovingAverage {
private:
    int windowSize;
    std::queue<int> window;
    double sum;

public:
    explicit MovingAverage(int k) : windowSize(k), sum(0) {}

    double next(int val) {
        window.push(val);
        sum += val;

        if (window.size() > windowSize) {
            sum -= window.front();
            window.pop();
        }

        return sum / window.size();
    }
};


#include <iostream>

int main() {
    MovingAverage ma(3);  // Window size = 3

    std::cout << ma.next(1) << std::endl;  // 1.0
    std::cout << ma.next(10) << std::endl; // (1+10)/2 = 5.5
    std::cout << ma.next(3) << std::endl;  // (1+10+3)/3 = 4.67
    std::cout << ma.next(5) << std::endl;  // (10+3+5)/3 = 6.0
}


Time per insertion: O(1)

Space complexity: O(k)

