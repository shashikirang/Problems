#include <queue>
#include <mutex>
#include <shared_mutex>

class ThreadSafeMovingAverage {
private:
    std::queue<int> window_;
    size_t windowSize_;
    double sum_;
    mutable std::shared_mutex mutex_;  // Allows shared reads, exclusive writes

public:
    explicit ThreadSafeMovingAverage(size_t k)
        : windowSize_(k), sum_(0) {}

    double next(int val) {
        std::unique_lock lock(mutex_);

        window_.push(val);
        sum_ += val;

        if (window_.size() > windowSize_) {
            sum_ -= window_.front();
            window_.pop();
        }

        return sum_ / window_.size();
    }

    double getCurrentAverage() const {
        std::shared_lock lock(mutex_);
        return window_.empty() ? 0.0 : sum_ / window_.size();
    }

    size_t currentSize() const {
        std::shared_lock lock(mutex_);
        return window_.size();
    }
};

#include <iostream>
#include <thread>
#include <vector>

int main() {
    ThreadSafeMovingAverage ma(3);

    std::vector<std::thread> threads;
    for (int i = 1; i <= 5; ++i) {
        threads.emplace_back([&ma, i]() {
            double avg = ma.next(i);
            std::cout << "Thread " << i << " added " << i << ", avg = " << avg << "\n";
        });
    }

    for (auto& t : threads) t.join();

    std::cout << "Final average: " << ma.getCurrentAverage() << "\n";
}
